# OpenAI
OPENAI_API_KEY=

# Banco de dados
DB_DRIVER=PostgreSQL
DB_SERVER=
DB_DATABASE=
DB_UID=
DB_PWD=
DB_SCHEMA=public
DB_TYPE=PostgreSQL
DB_PORT=5432
DB_SSLMODE=require

# Firebase Web (configuração pública usada pelo frontend)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_STORAGE_BUCKET=

# Firebase Admin: prefira Base64 em produção e caminho de arquivo localmente.
FIREBASE_CREDENTIALS_BASE64=
FIREBASE_CREDENTIALS_JSON=
FIREBASE_CREDENTIALS_PATH=

# Produção
NODE_ENV=production
PYTHONUNBUFFERED=1
COMPATIBILITY_ENGINE=deterministic
